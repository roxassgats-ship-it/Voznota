# === VOZNOTA - TikTok Video Analyzer ===
# Copia este archivo a .env y rellena tus claves

# Anthropic Claude API Key
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Discord Webhook URL (opcional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXX/XXXXXXXXXX

# Email (opcional) - usa Gmail con App Password
EMAIL_SENDER=tu_correo@gmail.com
EMAIL_PASSWORD=tu_app_password_de_gmail
EMAIL_RECIPIENT=destino@email.com

# Carpeta de salida (por defecto: ./outputs)
OUTPUT_DIR=./outputs

# Carpeta de descargas (por defecto: ./downloads)
DOWNLOAD_DIR=./downloads

# Puerto del dashboard web (por defecto: 5000)
DASHBOARD_PORT=5000

# Idioma preferido de análisis (es=Español, en=English)
ANALYSIS_LANGUAGE=es

# === NIVEL 2: Obsidian ===
# Ruta COMPLETA a tu vault de Obsidian (carpeta raíz)
OBSIDIAN_VAULT_PATH=/ruta/a/tu/obsidian/vault

# === NIVEL 3: n8n ===
# URL del webhook de n8n donde enviar eventos
N8N_WEBHOOK_URL=https://tu-n8n.com/webhook/voznota
# Puerto donde Voznota escucha triggers de n8n
N8N_INCOMING_PORT=5001

# === NIVEL 4: API Aislada ===
# Token secreto para autenticar llamadas externas a la API
API_SECRET_TOKEN=genera_un_token_seguro_aqui
